# Modo do provedor IoT: mock | ha-ws | bff
VITE_IOT_PROVIDER=mock

# Latência artificial (ms) aplicada pelo MockIoTProvider na V1
VITE_MOCK_LATENCY_MS=120

# Endpoints locais futuros para integração com Home Assistant (pós-V1)
VITE_HA_WS_URL=wss://smarthouse.local/api/websocket
VITE_IOT_BRIDGE_WS_URL=wss://smarthouse.local/ws

# Token do Home Assistant (apenas uso futuro server-side / iot-bridge; nunca commitar segredos)
HA_LONG_LIVED_TOKEN=
